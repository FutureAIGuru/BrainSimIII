<local:ModuleBaseDlg x:Class="BrainSimulator.Modules.ModuleSpellDlg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BrainSimulator.Modules"
             mc:Ignorable="d"
             Title="Add word spelling" Height="300" Width="530" Background="Gray" ShowInTaskbar="False"  >


    <Grid >
        
        <!-- Header -->
        <Label Content="Add Word Spelling" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        
        <!-- Single Word Input -->
        <StackPanel Orientation="Horizontal" Margin="10,57,-10,0" Height="23" VerticalAlignment="Top">
            <Label Content="Word:" VerticalAlignment="Center" Width="60"/>
            <TextBox x:Name="txtWord" Width="250" Margin="5,0" VerticalAlignment="Center" 
                     KeyDown="txtWord_KeyDown"/>
            <Button x:Name="btnAdd" Content="Add" Click="btnAdd_Click" 
                    Padding="15,5" Margin="5,0"/>
        </StackPanel>
        
        <!-- File Loading Section -->
        <Label Content="Load from File" FontWeight="Bold" Margin="0,124,98,-9"/>
        
        <StackPanel Orientation="Horizontal" Margin="0,150,0,0" Height="25" VerticalAlignment="Top">
            <Label Content="File:" VerticalAlignment="Center" Width="60"/>
            <TextBox x:Name="txtFilePath" Width="250" Margin="5,0" IsReadOnly="True" 
                     VerticalAlignment="Center" Background="#F0F0F0"/>
            <Button x:Name="btnBrowse" Content="Browse..." Click="btnBrowse_Click" 
                    Padding="15,5" Margin="5,0,5,0"/>
            <Button x:Name="btnLoad" Content="Load" Click="btnLoad_Click" 
                    Padding="15,5"/>
        </StackPanel>
        
    </Grid>
</local:ModuleBaseDlg>